# Copy to .env and fill in. Never commit the real .env.

# ── Database & app ──────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dharmakart?schema=public"
# Long random string (32+ chars) used to encrypt login sessions
SESSION_SECRET=""
NODE_ENV="production"
# Public site URL, no trailing slash. Payment gateways send customers back here.
# Leave empty for local testing (falls back to the request origin).
SITE_URL="https://dharmakart.in"

# ── Admin panel ─────────────────────────────────────────────────
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# ── Email (Gmail app password) ──────────────────────────────────
EMAIL_ENABLED="true"
EMAIL_USER=""
EMAIL_APP_PASSWORD=""

# ── PhonePe payment gateway (active) ────────────────────────────
# From PhonePe Business dashboard → Developer Settings (prod),
# or from the PhonePe integration team (sandbox/UAT).
PHONEPE_CLIENT_ID=""
PHONEPE_CLIENT_SECRET=""
PHONEPE_CLIENT_VERSION="1"
# sandbox | prod (also accepts "production")
PHONEPE_ENV="sandbox"
# Same username/password you set for the webhook on the PhonePe dashboard.
# Webhook URL: https://dharmakart.in/api/payments/phonepe/webhook
PHONEPE_WEBHOOK_USERNAME=""
PHONEPE_WEBHOOK_PASSWORD=""

# ── Easebuzz payment gateway (hidden) ───────────────────────────
# Set EASEBUZZ_ENABLED="true" to accept Easebuzz payments again.
EASEBUZZ_ENABLED="false"
EASEBUZZ_KEY=""
EASEBUZZ_SALT=""
# test | prod
EASEBUZZ_ENV="prod"
